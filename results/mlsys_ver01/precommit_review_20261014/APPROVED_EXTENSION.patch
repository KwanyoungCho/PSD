+                 rope=torch.zeros(batch*width,dtype=torch.int64,device=dev),
+                 slots=torch.full((batch*width,),-1,dtype=torch.int32,device=dev),
+                 lens=torch.full((batch,),cols,dtype=torch.int32,device=dev),
