diff --git a/ssd/ssd/engine/helpers/response_send.py b/ssd/ssd/engine/helpers/response_send.py
new file mode 100644
index 00000000..2645a269
--- /dev/null
+++ b/ssd/ssd/engine/helpers/response_send.py
@@ -0,0 +1,21 @@
+"""Bounded experiment: enqueue the two response payloads without a stream wait.
+
+The target receives both before it can issue its next request. The draft
+reaps here only after that next command arrives, before reusing wire buffers.
+Keep tensor references alive until Work.wait has ordered reuse on this stream.
+"""
+import torch.distributed as dist
+
+
+class ResponseSend:
+    def __init__(self):
+        self.pending = []
+
+    def enqueue(self, tensor, dst, group):
+        work = dist.isend(tensor, dst=dst, group=group)
+        self.pending.append((work, tensor))
+
+    def finish(self):
+        for work, _tensor in self.pending:
+            work.wait()
+        self.pending.clear()
diff --git a/ssd/tests/test_response_send.py b/ssd/tests/test_response_send.py
new file mode 100644
index 00000000..e27f274a
--- /dev/null
+++ b/ssd/tests/test_response_send.py
@@ -0,0 +1,45 @@
+"""No wait at enqueue, wire lifetime and bounded next-request retirement."""
+from unittest import TestCase, main
+from unittest.mock import patch, Mock
+import gc
+import weakref
+import torch
+from ssd.engine.helpers.response_send import ResponseSend
+
+
+class ResponseSendTests(TestCase):
+    def test_order_lifetime_and_retirement(self):
+        first, second = Mock(), Mock()
+        with patch('ssd.engine.helpers.response_send.dist.isend', side_effect=[first, second]) as send:
+            sender = ResponseSend()
+            tokens, logits = torch.arange(3), torch.ones(2, 11)
+            token_ref, logit_ref = weakref.ref(tokens), weakref.ref(logits)
+            sender.enqueue(tokens, 0, 'pg')
+            sender.enqueue(logits, 0, 'pg')
+            self.assertIs(send.call_args_list[0].args[0], tokens)
+            self.assertIs(send.call_args_list[1].args[0], logits)
+            first.wait.assert_not_called(); second.wait.assert_not_called()
+            send.reset_mock()
+            del tokens, logits
+            gc.collect()
+            self.assertIsNotNone(token_ref()); self.assertIsNotNone(logit_ref())
+            sender.finish()
+            self.assertEqual(sender.pending, [])
+            first.wait.assert_called_once(); second.wait.assert_called_once()
+            gc.collect()
+            self.assertIsNone(token_ref()); self.assertIsNone(logit_ref())
+            sender.finish()
+            self.assertEqual(first.wait.call_count, 1)
+
+    def test_failure_retains_wire_buffers(self):
+        work = Mock(); work.wait.side_effect = RuntimeError('peer failure')
+        sender = ResponseSend()
+        with patch('ssd.engine.helpers.response_send.dist.isend', return_value=work):
+            sender.enqueue(torch.ones(2), 0, None)
+        with self.assertRaisesRegex(RuntimeError, 'peer failure'):
+            sender.finish()
+        self.assertEqual(len(sender.pending), 1)
+
+
+if __name__ == '__main__':
+    main()
