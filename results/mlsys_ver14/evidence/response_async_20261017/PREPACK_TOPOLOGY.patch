diff --git a/ssd/ssd/engine/helpers/response_topology.py b/ssd/ssd/engine/helpers/response_topology.py
new file mode 100644
index 00000000..fc9df34c
--- /dev/null
+++ b/ssd/ssd/engine/helpers/response_topology.py
@@ -0,0 +1,39 @@
+"""Immutable small topology packets prepared before the next cache request.
+
+No vocabulary logits are materialized. Validation still happens for the hit
+root before any response is sent. Python integers avoid repeated CPU-tensor
+scalar conversions during that validation.
+"""
+from dataclasses import dataclass
+import torch
+from ssd.engine.helpers.p2_tree import tree_wire_ints_len, parse_tree_ints, validate_tree_ints
+
+
+@dataclass(frozen=True)
+class ResponseTopology:
+    capacity: int
+    device_rows: torch.Tensor
+    host_rows: torch.Tensor
+    integer_rows: tuple
+
+    def select(self, root, vocab_size):
+        if not 0 <= root < len(self.integer_rows):
+            raise IndexError('Response root outside topology snapshot')
+        parsed = parse_tree_ints(self.integer_rows[root], self.capacity)
+        validate_tree_ints(parsed, self.capacity, vocab_size)
+        return self.device_rows[root], self.host_rows[root], parsed
+
+
+def prepare_response_topology(views, capacity):
+    count, width = views['tok'].shape
+    copy_n = min(width, capacity)
+    packed = torch.zeros((count, tree_wire_ints_len(capacity)),
+                         dtype=torch.int64, device=views['valid'].device)
+    packed[:, 0].copy_(views['valid'])
+    packed[:, 1].copy_(views['u_valid'])
+    packed[:, 2].fill_(1)
+    for i, name in enumerate(('tok', 'parent_local', 'sib_order', 'parent_q_ref')):
+        packed[:, 3+i*capacity:3+i*capacity+copy_n].copy_(views[name][:, :copy_n])
+    host = packed.detach().cpu()
+    integers = tuple(tuple(row) for row in host.tolist())
+    return ResponseTopology(capacity, packed, host, integers)
diff --git a/ssd/tests/test_response_topology.py b/ssd/tests/test_response_topology.py
new file mode 100644
index 00000000..6d5fa2aa
--- /dev/null
+++ b/ssd/tests/test_response_topology.py
@@ -0,0 +1,52 @@
+from unittest import TestCase, main, skipUnless
+import torch
+from ssd.engine.helpers.response_topology import prepare_response_topology
+from ssd.engine.helpers.p2_tree import pack_tree_ints
+
+
+def views(device):
+    return {k: torch.tensor(v, device=device) for k, v in dict(
+        tok=[[1,2,3],[4,5,6]], valid=[3,2], u_valid=[2,1],
+        parent_local=[[-1,-1,0],[-1,-1,-1]], sib_order=[[0,1,0],[0,1,2]],
+        parent_q_ref=[[0,0,1],[0,0,0]]).items()}
+
+
+class ResponseTopologyTests(TestCase):
+    def check_equivalence(self, device):
+        source=views(device)
+        for cap in (3,5):
+            snapshot=prepare_response_topology(source,cap)
+            for root in range(2):
+                gpu,cpu,parsed=snapshot.select(root,10)
+                expected=pack_tree_ints(source,root,cap)
+                self.assertTrue(torch.equal(gpu,expected))
+                self.assertTrue(torch.equal(cpu,expected.cpu()))
+                self.assertEqual(parsed['valid'],int(source['valid'][root]))
+                self.assertIsInstance(parsed['tok'][0],int)
+
+    def test_exact_padding_and_fields(self):
+        self.check_equivalence('cpu')
+
+    @skipUnless(torch.cuda.is_available(),'CUDA required')
+    def test_cuda_pack_and_readback(self):
+        self.check_equivalence('cuda:0')
+
+    def test_snapshot_does_not_alias_executor_buffers(self):
+        source=views('cpu');snapshot=prepare_response_topology(source,3)
+        for tensor in source.values():tensor.fill_(-1)
+        gpu,cpu,parsed=snapshot.select(0,10)
+        self.assertEqual(parsed['tok'],(1,2,3))
+        self.assertTrue(torch.equal(gpu,cpu))
+
+    def test_malformed_hit_is_still_rejected(self):
+        for key in ('valid','u_valid','tok','parent_local','sib_order','parent_q_ref'):
+            with self.subTest(key=key):
+                source=views('cpu')
+                if key in ('valid','u_valid'):source[key][0]=99
+                else:source[key][0,0]=99
+                snapshot=prepare_response_topology(source,3)
+                with self.assertRaises(RuntimeError):snapshot.select(0,10)
+        with self.assertRaises(IndexError):prepare_response_topology(views('cpu'),3).select(2,10)
+
+
+if __name__=='__main__':main()
