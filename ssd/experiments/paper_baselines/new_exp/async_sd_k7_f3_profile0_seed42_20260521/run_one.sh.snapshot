#!/usr/bin/env bash
# Async SD k=7 f=3 PROFILE=0 reverify — single run, paired with the
# MESA K1=7 K2=5 D_current_off_reverify_20260518 cell (same seed=42,
# same date, same env). Reuses the verbatim async_sd_sweep/k7_f3 command.

set -euo pipefail

ROOT="/home/chokwans99/PSD/ssd"
PHASE_DIR="${ROOT}/experiments/proxy_async_overlap/async_sd_k7f3_reverify"
PY="/home/chokwans99/anaconda3/envs/ssd/bin/python"

LABEL="${1:-reverify_20260521}"
SEED="${2:-42}"

OUTDIR="${PHASE_DIR}/${LABEL}"
mkdir -p "${OUTDIR}"

cd "${ROOT}"

export CUDA_VISIBLE_DEVICES=0,1,2,3,4
export SSD_DIST_PORT=12673
export SSD_CUDA_ARCH=8.6
export TORCH_CUDA_ARCH_LIST=8.6
export SSD_HF_CACHE=/home/chokwans99/.cache/huggingface/hub
export SSD_DATASET_DIR=/data2/chokwans99/datasets
export MPLCONFIGDIR=/tmp/matplotlib
# NO MESA env, NO SSD_FORCE_SPLIT_K1K2; SSD_PROFILE_MESA unset == 0 cold path.

echo "[$(date -Is)] === START ${LABEL} (async SD k=7 f=3, PROFILE=0, seed=${SEED}) ===" | tee "${OUTDIR}/run.log"
pkill -9 -f "bench.py" 2>/dev/null || true
sleep 5

"${PY}" -O bench/bench.py \
  --llama --size 8 \
  --model_path /data2/chokwans99/awq_calibrated/layerskip_llama2_70b \
  --quant_awq \
  --quant_awq_artifact /data2/chokwans99/awq_artifacts/layerskip_llama2_70b/autoawq_tp4 \
  --quant_group_size 128 \
  --gpus 5 --b 1 --temp 0.7 --seed "${SEED}" --numseqs 50 \
  --input_len 512 --output_len 512 --all --max_model_len 2048 \
  --draft_path /data2/chokwans99/awq_calibrated/tinyllama_1b \
  --quant_awq_draft \
  --quant_awq_draft_artifact /data2/chokwans99/awq_artifacts/tinyllama_1b/draft_tp1 \
  --async --spec --k 7 --f 3 \
  2>&1 | tee -a "${OUTDIR}/run.log"

echo "[$(date -Is)] === END ${LABEL} ===" | tee -a "${OUTDIR}/run.log"

{
  echo "label=${LABEL} seed=${SEED}"
  grep -E "Final Decode Throughput|Avg target time|Avg Tokens per step|Avg Fraction of Speculated|Avg Cache Hits" "${OUTDIR}/run.log" || true
} > "${OUTDIR}/headline.txt"

cat "${OUTDIR}/headline.txt"
